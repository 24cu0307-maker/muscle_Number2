* text=auto

# Source code and Unity text assets use a repository-wide LF format.
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.playable text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.bytes binary
